<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container listing-page">
  <header class="page-header author-header">
    <% if (author.avatar) { %>
      <img class="avatar" src="<%= author.avatar %>" alt="" width="88" height="88">
    <% } %>
    <div>
      <p class="kicker"><%= author.role %></p>
      <h1><%= author.name %></h1>
      <% if (author.bio) { %>
        <p class="lede"><%= author.bio %></p>
      <% } %>
    </div>
  </header>

  <% if (posts.length) { %>
    <div class="card-grid">
      <% posts.forEach(function (post) { %>
        <%- include('../partials/post-card', { post: post }) %>
      <% }) %>
    </div>
    <%- include('../partials/pager') %>
  <% } else { %>
    <p class="empty">This author has no published stories yet.</p>
  <% } %>
</main>

<%- include('../partials/footer') %>
