  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <p class="logo footer-logo"><span class="logo-mark" aria-hidden="true">⌁</span> <%= siteName %></p>
        <p class="muted"><%= siteTagline %></p>
      </div>
      <nav aria-label="Footer">
        <p class="footer-heading">Sections</p>
        <ul class="footer-links">
          <% (typeof categories !== 'undefined' && categories ? categories : []).forEach(function (cat) { %>
            <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
          <% }) %>
        </ul>
      </nav>
      <div>
        <p class="footer-heading">Stay in the loop</p>
        <p class="muted">A short briefing, not an inbox avalanche.</p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© <%= new Date().getFullYear() %> <%= siteName %>. Built for readers first. <button type="button" class="cookie-manage" data-cookie-manage>Cookies</button></p>
    </div>
  </footer>
  <div class="cookie-banner" id="cookie-banner" hidden>
    <div class="cookie-banner-inner">
      <p><strong>Cookies.</strong> We store your choice in a cookie. If you accept, we also remember light or dark mode. Staff sign-in uses its own essential cookie. No ad trackers.</p>
      <div class="cookie-banner-actions">
        <button type="button" class="btn btn-accent" data-cookie-choice="all">Accept</button>
        <button type="button" class="btn cookie-banner-ghost" data-cookie-choice="essential">Essential only</button>
      </div>
    </div>
  </div>
  <script src="/js/cookies.js" defer></script>
  <script src="/js/theme.js" defer></script>
  <script src="/js/main.js" defer></script>
  <script src="/js/search.js" defer></script>
  <script src="/js/comments.js" defer></script>
  <script src="/js/newsletter.js" defer></script>
</body>
</html>
