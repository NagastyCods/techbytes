# Copy this file to .env and fill in real values.
# Never commit .env — it holds secrets.

PORT=3000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/techbytes

# JWT cookie signing. Use a long random string in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public site URL — canonical links, Open Graph, RSS, sitemap. No trailing slash.
# Production example: https://techbytes.onrender.com
SITE_URL=http://localhost:3000
SITE_NAME=TechBytes
SITE_TAGLINE=Tech news without the noise

# Optional SMTP. If blank, newsletter still saves to MongoDB; no welcome email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TechBytes <hello@example.com>"
