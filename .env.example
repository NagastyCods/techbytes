# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Local: mongodb://127.0.0.1:27017/techbytes
# Atlas: allow 0.0.0.0/0 so Vercel’s changing egress IPs can connect.
MONGODB_URI=mongodb://127.0.0.1:27017/techbytes

# Required in production. Use a long random string.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Optional. Vercel fills this from the deployment hostname when unset.
# Set it to your custom domain (no trailing slash) when you have one.
SITE_URL=http://localhost:3000
SITE_NAME=TechBytes
SITE_TAGLINE=Tech news without the noise

PORT=3000
NODE_ENV=development

# Optional welcome emails. Subscriptions still save when these are empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TechBytes

# Injected automatically when a Vercel Blob store is connected. Do not set locally
# unless you want local uploads to go to Blob too.
# BLOB_READ_WRITE_TOKEN=
